# ============================================================
#  claude-remote-ops: скопируйте этот файл в .env и заполните
# ============================================================

# --- Telegram (обязательно) ---
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Ваш числовой Telegram ID (узнать: @userinfobot). Все остальные пользователи игнорируются.
ADMIN_USER_ID=123456789

# --- Песочница файловой системы (обязательно) ---
# Разрешенные папки через ";" (как в PATH). Только внутри них работают проводник, /get,
# загрузка файлов и запуск Claude (cwd). Пути проверяются без учета регистра.
# Пример нескольких папок: C:\Projects;D:\work;C:\Users\<you>\Documents
ALLOWED_DIRS=C:\Projects
# Папки, которые проводник и поиск пропускают (через ;). Пусто = значения по умолчанию.
# IGNORED_DIRS=.git;__pycache__;node_modules;.venv;venv;dist;build
SHOW_HIDDEN_FILES=false
# Подпапка в первой ALLOWED_DIRS для файлов с телефона, если рабочая папка не выбрана
UPLOAD_SUBDIR=_uploads

# --- Claude CLI ---
# Имя или полный путь (claude.exe / claude.cmd / claude.ps1). Ищется через shutil.which.
CLAUDE_BINARY=claude
# История сессий (по умолчанию %USERPROFILE%\.claude\projects)
# CLAUDE_PROJECTS_DIR=C:\Users\<you>\.claude\projects
# Полный доступ по умолчанию: передается --dangerously-skip-permissions (любые Bash, Skills,
# MCP-серверы mcp__*), --allowedTools при этом НЕ передается. Бот и так закрыт AuthMiddleware
# по ADMIN_USER_ID. Переключается в боте: /mode -> 🔓 Skip Permissions / 🔒 Restricted Tools.
SKIP_PERMISSIONS_DEFAULT=true
# Используется только в режиме 🔒 Restricted Tools. mcp__* = инструменты всех MCP-серверов.
CLAUDE_ALLOWED_TOOLS=Read,Edit,MultiEdit,Write,Glob,Grep,LS,Bash,Skill,Task,WebFetch,WebSearch,NotebookEdit,mcp__*
# Лимиты профиля «♾ Auto». 0 или пусто = флаг не передается в claude.exe (без лимита).
# Профили 💵 Эконом ($2 / 15 ходов) и 🚀 Pro ($15 / 80 ходов) переключаются в /mode.
CLAUDE_MAX_TURNS=0
CLAUDE_MAX_BUDGET_USD=0
# Модель и уровень ризонинга для первого запуска бота. Дальше переключаются кнопками /model
# (выбор сохраняется в data/state.json и переживает перезапуск).
# CLAUDE_MODEL: default (= модель из настроек Claude Code) | sonnet | opus | haiku | fable | полное имя
CLAUDE_MODEL=default
# CLAUDE_REASONING_EFFORT: default (= настройки CLI) | off | low | medium | high | xhigh | max
#   off    -> --effort low + MAX_THINKING_TOKENS=0 + CLAUDE_CODE_DISABLE_THINKING=1 (без размышлений)
#   low    -> --effort low    + MAX_THINKING_TOKENS=4096
#   medium -> --effort medium + MAX_THINKING_TOKENS=10000
#   high   -> --effort high   + MAX_THINKING_TOKENS=20000
#   xhigh  -> --effort xhigh  + MAX_THINKING_TOKENS=24000
#   max    -> --effort max    + MAX_THINKING_TOKENS=32000 + ключевое слово ultrathink в запросе
# Новые модели (Opus/Sonnet 4.6+, семейство 5.x) думают адаптивно и слушают --effort,
# бюджет MAX_THINKING_TOKENS действует на старых (claude-haiku-4-5, claude-sonnet-4-5).
CLAUDE_REASONING_EFFORT=default
# Жесткий лимит времени одного запуска, секунды (долгие сборки и браузерные сценарии)
CLAUDE_TIMEOUT_SEC=3600
MAX_CONCURRENT_RUNS=2
# Чат открыт фоновой сессией на ПК (claude --bg, agents view) и --resume отказывается его продолжать:
#   ask  = показать кнопки 🌿 Ответвить копию (--fork-session) и 🛑 Остановить фоновую (claude stop <id>)
#   fork = сразу повторить запрос в копии чата с полным контекстом, сессия на ПК не трогается
# Значение по умолчанию для первого запуска, дальше переключается в боте: /mode
BG_SESSION_POLICY=ask

# --- Голосовые сообщения (Voice-to-Prompt, faster-whisper) ---
VOICE_ENABLED=true
# Модель: tiny | base | small | medium | large-v3 | turbo. Скачивается при первом голосовом (medium ~1.5 ГБ)
WHISPER_MODEL=medium
# auto = CUDA, если реально загружаются cuBLAS 12 и cuDNN 9, иначе CPU int8. Можно явно: cpu / cuda
# DLL ставятся из requirements.txt (nvidia-cublas-cu12, nvidia-cudnn-cu12), бот сам добавляет их в поиск
WHISPER_DEVICE=auto
# Пусто = float16 на CUDA, int8 на CPU. Для GPU с малым объемом памяти: int8_float16
WHISPER_COMPUTE_TYPE=
# Язык речи (пусто = автоопределение)
WHISPER_LANGUAGE=ru
# Папка для моделей (пусто = кэш Hugging Face в %USERPROFILE%\.cache\huggingface)
WHISPER_DOWNLOAD_DIR=
# Подсказка для смешанной русско-английской IT-лексики
WHISPER_INITIAL_PROMPT=Claude, Python, Figma, Git, Bash, MCP, API, Docker, pytest, рефакторинг, презентация, слайды, скилл
WHISPER_BEAM_SIZE=5
# true = сразу запускать Claude с распознанным текстом; false = текст с кнопками ▶️ Запустить / ❌ Отмена
VOICE_AUTO_RUN=true
# Максимальная длина голосового, секунды
VOICE_MAX_DURATION_SEC=600

# --- Интерфейс и лимиты ---
STATUS_UPDATE_INTERVAL=3
SESSIONS_PAGE_SIZE=8
PROJECTS_PAGE_SIZE=8
FILES_PAGE_SIZE=14
PREVIEW_LINES=50
# Лимит отправки файла ботом (Bot API: 50 МБ)
MAX_SEND_FILE_MB=50
# Лимит скачивания файла от пользователя (Bot API getFile: 20 МБ)
MAX_DOWNLOAD_FILE_MB=20
# Ответ длиннее MAX_INLINE_CHUNKS сообщений по 4000 символов уходит файлом response.md
MAX_INLINE_CHUNKS=3
SEARCH_RESULTS_LIMIT=20

# --- Авто-отчеты (watchdog) ---
WATCH_ON_START=true
# Пауза после последней записи в сессию перед пуш-отчетом, секунды
WATCH_DEBOUNCE_SEC=30
# Не присылать отчеты о headless-запусках (claude -p, в том числе запущенных самим ботом)
WATCH_IGNORE_HEADLESS=true

# --- Расход и лимиты (/usage, /cost, /stats) ---
# Живые квоты подписки (Current session 5 ч / Current week): GET /api/oauth/usage с OAuth-токеном
# claude.ai из .credentials.json, как это делает сам Claude Code. Токены модели не тратятся.
# Бот токен не обновляет: если он истек, показывается последний сохраненный снимок (data/quota_cache.json).
USAGE_QUOTA_ENABLED=true
# Не чаще одного живого запроса за столько секунд (/status, /usage); кнопка 🔄 запрашивает сразу
USAGE_QUOTA_MIN_INTERVAL_SEC=30
# USAGE_API_BASE_URL=https://api.anthropic.com
# CLAUDE_CREDENTIALS_FILE=C:\Users\<you>\.claude\.credentials.json
# Запрос считается «тяжелым», если контекст (вход + чтение кэша + запись кэша) больше этого числа токенов
USAGE_HEAVY_CONTEXT_TOKENS=150000

# --- Перезапуск с телефона (/restart) ---
# Сколько ждать готовности нового процесса, секунды (start_bot.ps1 может сначала запустить pip install).
# Не дождались = перезапуск отменяется, старый процесс продолжает работать.
RESTART_READY_TIMEOUT_SEC=180

# --- Служебное ---
LOG_LEVEL=INFO
# DATA_DIR=data
# LOG_DIR=logs
